!famail_temporal/results/level2_table/
!famail_temporal/results/overnight_2026-06-10/
!famail_temporal/results/weighted_bc_sweep/
# --- re-ignore collateral swept in by the run-dir un-ignore ---
famail_temporal/results/**/*.png
famail_temporal/results/**/*.jsonl
famail_temporal/results/**/*.sh
famail_temporal/results/**/*.log
famail_temporal/results/**/*.txt
famail_temporal/results/**/ALL_DONE
famail_temporal/results/**/pid.txt
