# Large datasets / binary artifacts
*.pkl
*.npz
*.npy
*.parquet
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.onnx
*.zip
*.tar
*.tar.gz
*.7z
*.csv
*.json

# Notebooks outputs / caches
**/__pycache__/
**/.pytest_cache/
**/.ipynb_checkpoints/

# Local envs
.venv/
venv/
.env

# Outputs
**/output/
**/derived/

!**/*.sample.json
!**/*.schema.md
!**/.gitkeep
data/visualization/streamlit/ai_context_docs/*

# Claude Code dependencies
.claude
CLAUDE.md

# Website build output (regenerated by mkdocs build)
/site/

# famail_temporal data/cache/checkpoints
famail_temporal/source_data/*
!famail_temporal/source_data/.gitkeep
!famail_temporal/source_data/README.md
famail_temporal/cache/*
!famail_temporal/cache/.gitkeep
!famail_temporal/cache/README.md
famail_temporal/discriminator_checkpoints/*
!famail_temporal/discriminator_checkpoints/.gitkeep
!famail_temporal/discriminator_checkpoints/README.md

# supply-lift Stage-0 oracle (gate G0) CLI run-output artifacts
famail_temporal/analysis/supply_lift_oracle_out/
!famail_temporal/discriminator_checkpoints/default/
famail_temporal/discriminator_checkpoints/default/*.pt

# Evaluation framework output (per-experiment directories)
famail_temporal/results/*
!famail_temporal/results/.gitkeep
# Fairness-attribution export artifacts (per-run timestamped dirs)
famail_temporal/exports/*
!famail_temporal/exports/.gitkeep
!famail_temporal/exports/USING_FAIRNESS_ATTRIBUTION_EXPORTS.md
logs/

# Discriminator training outputs (per-run timestamped dirs)
checkpoints/

# External-fairness CLI run outputs (data artifacts, per-dataset dirs)
famail_temporal/baselines/external_fairness/results/

# Data-augmentation baseline table (campaign Q1) — the curated artifact behind the
# paper's tab:baselines. Re-included past the global *.json ignore, same rationale as
# the curated-results block below: a negation (not `git add -f`) is what lets graphify
# see the file, since its corpus walk merges this .gitignore.
!famail_temporal/baselines/baseline_table/baseline_table.json
!famail_temporal/baselines/baseline_table/environment.json

# PAPER/ is the curated, committed paper deliverable: force-track its data
# tables (the global *.json/*.csv ignores above would otherwise drop them).
!PAPER/**/*.json
!PAPER/**/*.csv

# >>> graphify-tracked curated results (auto-generated; see .graphifyignore) >>>
# Track ONLY the run reports + <=64KB data files cited by committed docs, so the
# graphify knowledge graph can see them. Run-dirs are un-ignored so git can descend;
# collateral file types are re-ignored; then the specific cited files are re-included.
# --- un-ignore cited run-dirs (allow descent) ---
!famail_temporal/results/2026-05-28T08-51-32_k-10000_causal_emphasis_no-dedup/
!famail_temporal/results/2026-07-01T09-59-11_sf12-dual/
